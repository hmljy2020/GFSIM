#pragma once

#include <cstdint>

#include "SimModule.h"
#include "SimState.h"

namespace gfsim {

class @MODULE_NAME@ final : public SimModule {
public:
    explicit @MODULE_NAME@(SimSystem* system = nullptr);

    void Build() override;
    void Work() override;
    void Xfer() override;
    void Reset() override;
    void ReportStat() override;

    // Optional INPUT and OUTPUT SimQueue<T>* fields belong here.
    // Arithmetic/enum T travels by value; class/struct T travels by shared_ptr<T>.
    // Bind them with BindInput/BindOutput in the constructor.
    // For optional ports use p ? BindInput(p) : nullptr (and BindOutput).
    // GFIR functions become ordinary method calls, not extra modules or queues.
    // For module calls, keep a typed non-owning target pointer and initialize
    // it with BindModule(target), or target ? BindModule(target) : nullptr.
    // Const targets are supported. References add no object capacity.
    // Optional child modules and INNER queues are owned through
    // AddSubmodule/AddInnerQueue in Build().

private:
    SimState<std::uint64_t> count_; // embedded; not part of Objects() or Submodules()

    PURE static std::uint64_t NextCount(std::uint64_t prior) { return prior + 1; }
    std::uint64_t UpdateState();
};

} // namespace gfsim
