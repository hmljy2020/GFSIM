#include "@MODULE_NAME@.h"

namespace gfsim {

@MODULE_NAME@::@MODULE_NAME@(SimSystem* system)
    : SimModule("@MODULE_NAME@", system) {}

void @MODULE_NAME@::Build()
{
    SetObjectCapacity(0); // replace 0 with exact child-module + inner-queue count
    // Own every physical queue here; bind each to one output and one input.
    // Create optional child modules and inner queues before these calls.
    BuildInnerQueues();
    BuildChildren();
}

void @MODULE_NAME@::Work()
{
    nextState_ = state_; // current state is read-only during evaluation
    // Atomic queue transfer pattern when ports exist:
    // In a local helper: if (input_->Empty() || output_->Full()) return;
    // A local stall must never skip the WorkChildren() call below.
    // auto result = PureTransform(input_->Front());
    // output_->Write(std::move(result));
    // input_->Pop(); // consume only after output write succeeds
    // Modules with no ports can update local state directly.
    // Small scalar token: output_->Write(input_->Front()); input_->Pop();
    // Class source: auto packet = std::make_shared<Message>(...);
    // Class later stage: peek input_->Front(), compute a PURE result,
    // write output, then input_->Pop(). Mutate a forwarded packet only
    // after its output Write succeeds.
    // Call GetSim()->MarkProgress() only after a real operation fires.
    UpdateState();
    Log().Debug("@MODULE_NAME@", "work") << "work_cycles=" << nextState_.workCycles;
    WorkChildren();
}

void @MODULE_NAME@::Xfer()
{
    // Commit private state only; queue readiness belongs in Work().
    state_ = nextState_;
    // Do not query queues here: their advancement may run on other workers.
    // The helper skips queues delegated to those workers.
    AdvanceInnerQueues();
    XferChildren();
}

void @MODULE_NAME@::Reset()
{
    state_ = State{};
    nextState_ = state_;
    ResetInnerQueues();
    ResetChildren();
}

void @MODULE_NAME@::ReportStat()
{
    auto& report = Report();
    report.ReportTitle("@MODULE_NAME@ Stats");
    report.ReportVal("Work cycles", state_.workCycles);
    ReportChildren();
}

void @MODULE_NAME@::UpdateState()
{
    nextState_.workCycles = NextCount(state_.workCycles);
}

} // namespace gfsim
